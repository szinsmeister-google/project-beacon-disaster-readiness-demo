# ============================================================================
# Project Beacon: Disaster Readiness & Policy Intelligence — Environment Config
# Copy to `.env` and fill in your GCP / Argolis project details.
# ============================================================================

# Core Google Cloud Project (required)
GCP_PROJECT_ID="your-gcp-or-argolis-project-id"
GOOGLE_CLOUD_PROJECT="your-gcp-or-argolis-project-id"
GCP_PROJECT_NUMBER="123456789012"
GCP_REGION="us-central1"

# Cloud Spanner Operational Graph (`DCGraph`)
SPANNER_PROJECT="your-gcp-or-argolis-project-id"
SPANNER_INSTANCE="dc-graph-demo"
SPANNER_DATABASE="readiness_dcgraph"
# Optional: set SPANNER_OMNI_ENDPOINT="localhost:15000" to run against local Docker Spanner Omni
SPANNER_OMNI_ENDPOINT=""

# BigQuery Borderless Lakehouse (Apache Iceberg + Unstructured SitRep PDF Object Tables)
BQ_DATASET_ID="beacon_disaster_readiness"
BQ_LOCATION="US"
BQ_CONNECTION_LOCATION="us"
BQ_LAKEHOUSE_CONN="beacon_lakehouse_conn"
GCS_LAKEHOUSE_BUCKET="${GCP_PROJECT_ID}-beacon-lakehouse"

# Google Cloud Knowledge Catalog (Dataplex Universal Catalog)
KC_GLOSSARY_ID="beacon-disaster-readiness-glossary"
KC_ASPECT_TYPE_ID="beacon-federal-governance"

# Vertex AI / GEV System-One ADK Agent & Gemini Data Analytics
AGENT_MODEL="gemini-2.5-flash"
JEV_MODEL="gemini-2.5-flash"
JEV_LOCATION="us-central1"
MODEL_LOCATION="global"
DATA_AGENT_ID="beacon_disaster_readiness_agent"
DISCOVERY_ENGINE_ID="your-discovery-engine-id"

# Optional: Google Data Commons API Key (for live remote MCP calls outside Spanner)
DC_API_KEY=""
DC_MCP_URL="https://api.datacommons.org/mcp"

# Optional: Looker Instance & Data App
LOOKER_BASE_URL="https://your-instance.cloud.looker.com"
LOOKER_CLIENT_ID="your-looker-api3-client-id"
LOOKER_CLIENT_SECRET="your-looker-api3-client-secret"
LOOKER_DASHBOARD_ID="519"
LOOKER_BQ_CONNECTION="your-bigquery-connection-name"

# Demo Operator Attribution (written to DeploymentPlan.added_by)
DEMO_OPERATOR_EMAIL="demo-operator@example.com"
